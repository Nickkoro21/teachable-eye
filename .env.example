# Copy to .env (git-ignored). Every value below is the default.

# Where memories, thumbnails, models and reports live (never committed).
# TEYE_DATA_DIR=data

# --- objects ----------------------------------------------------------------
# Image encoder: dinov2-large (default), dinov2-base, siglip2-base, unicom-b16,
# clip-b32. Each encoder has its own memory and its own score scale.
OBJECT_ENCODER=dinov2-large
# score >= THRESHOLD -> known; THRESHOLD-MARGIN..THRESHOLD -> uncertain.
# Leave unset to use the encoder's provisional default (config.py), e.g.
# dinov2-large 0.45/0.10, clip-b32 0.90/0.05. Calibrate with the evaluation tool.
# OBJECTS_THRESHOLD=0.45
# OBJECTS_MARGIN=0.10

# --- people (YuNet + SFace) -------------------------------------------------
PEOPLE_THRESHOLD=0.40
PEOPLE_MARGIN=0.06

# --- detection --------------------------------------------------------------
DETECT_CONF=0.30
DETECT_MIN_AREA=0.0003
DETECT_MAX_AREA=0.90

# --- runtime ----------------------------------------------------------------
ENCODER_DEVICE=auto
VOICE_LANGUAGE=en
TEYE_PORT=8765

# Teach-time augmentation: zoom, flip and darker variants of each view (on|off)
AUGMENT=on
